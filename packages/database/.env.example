# Prisma CLI (run from this package directory) reads its own .env, separate
# from apps/api/.env — keep both in sync. See apps/api/.env.example's
# comment for the Session-pooler/IPv6/percent-encoding notes.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
