# Supabase project → Settings → API → JWT Settings → JWT Secret.
# Required in every environment (no dev-bypass here — the NestJS API's own
# AUTH_DEV_BYPASS is where local-dev-without-login is handled; this service
# always verifies for real).
SUPABASE_JWT_SECRET=

# Informational only right now (verification is local, via the shared
# secret above) — kept for the day this needs to call Supabase directly
# (e.g. to revoke a session).
SUPABASE_URL=
