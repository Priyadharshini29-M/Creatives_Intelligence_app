# apps/ai has no required env vars for Phases 1-3 (config.py's defaults cover
# ffprobe/ffmpeg/whisper). Copy this to .env and fill in the values below to
# enable the Creative Intelligence parallel analyzers.

# OCR module — must point at a real Tesseract OCR install (the pytesseract
# package only shells out to it, it doesn't vendor the binary). On Windows,
# install from https://github.com/UB-Mannheim/tesseract/wiki and point this
# at tesseract.exe if it isn't on PATH.
TESSERACT_BIN=tesseract

# Gemini Vision (scene.json) + Gemini sales engine (copy corrections/ROAS/
# claim safety) — get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
