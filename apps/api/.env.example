# ── Server ─────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────
# Supabase Postgres (migrated from local MySQL 2026-09-11). Use the Session
# pooler connection string from Settings → Database → Connection string —
# the direct db.<ref>.supabase.co host only resolves to IPv6, which fails
# to connect on networks without IPv6 egress ("Can't reach database
# server"); the Transaction pooler (port 6543) doesn't support the prepared
# statements Prisma's migration engine needs. Percent-encode any special
# characters in the password (e.g. '#' → '%23' — an un-encoded '#' starts a
# URL fragment and silently truncates everything after it).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Redis / BullMQ ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Object storage (MinIO locally, AWS S3 in prod) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vip_minio
S3_SECRET_KEY=vip_minio_password
S3_BUCKET_VIDEOS=videos
S3_FORCE_PATH_STYLE=true

# ── Auth (Supabase) ────────────────────────────
# Supabase issues sessions straight to the frontend; this API verifies them
# via the Python auth service (apps/auth) at the URL below. For local
# development without a Supabase project, set AUTH_DEV_BYPASS=true instead.
AUTH_DEV_BYPASS=true
AUTH_SERVICE_URL=http://localhost:8001

# ── AI service ─────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
